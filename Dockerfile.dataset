# Reproducible generator image. The generated CSVs are written to the mounted v2 directory.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY scripts/dataset ./scripts/dataset
RUN mkdir -p /app/public/softtek/dataset/dataset-hackathon-road2tech/v2

CMD ["python", "scripts/dataset/run_all.py"]
