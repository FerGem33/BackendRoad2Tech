# Copy to .env and fill in. Never commit real keys.

# --- LLM: Gemini through Google AI Studio (https://aistudio.google.com/apikey) ---
# Without a key the agent runs in offline mode (keyword intent parser + templated answers).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_MODE=auto            # auto | gemini | offline

# --- Data: the BackendRoad2Tech v2 dataset ---
DATA_BACKEND=csv         # csv | postgres
DATASET_DIR=../../public/softtek/dataset/dataset-hackathon-road2tech/v2   # generated by scripts/dataset/run_all.py
DATABASE_URL=            # postgresql://stockcopilot:stockcopilot@localhost:5432/stockcopilot
CHECKPOINTER=memory      # memory | postgres (LangGraph checkpoints survive restarts)

# Demo "today" (the dataset ends 2026-09-30). Empty = last day of data.
DEMO_AS_OF=2026-09-16

# --- Forecast: local deterministic baseline or published SageMaker batch output ---
FORECAST_PROVIDER=local # local | dynamodb
FORECAST_TABLE_NAME=    # required when FORECAST_PROVIDER=dynamodb
AWS_REGION=us-east-1

CORS_ORIGINS=["http://localhost:3000"]
